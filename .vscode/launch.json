  {                                                                                                                                  
      "version": "0.2.0",                                                                                                            
      "configurations": [                                                                                                            
          {
              "name": "Debug backend",
              "type": "python",
              "request": "launch",
              "console": "integratedTerminal",
              "justMyCode": false,
              "python": "${workspaceFolder}/backend/.venv/bin/python",
              "module": "uvicorn",
              "args": [
                  "app.main:app",
                  "--reload"
              ],
              "cwd": "${workspaceFolder}/backend",
              "env": {
                  "PYTHONPATH": "${workspaceFolder}/backend"
              },
              "envFile": "${workspaceFolder}/backend/.env.dev"
          }                                                                                                                          
      ]                                                                                                                              
  }